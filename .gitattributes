* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary

# Dataset CTĐT ghi SHA-256 của file nguồn: giữ nguyên LF trên mọi máy để mã băm khớp.
/data/raw/official_curricula/*.json text eol=lf

# Preserve the downloaded evidence bytes: the review manifest records their hashes.
/data/raw/reviewed_sources/* -text -whitespace

# Legacy source manifests retain their original line endings.
/data/raw/hust_curriculum_extractions.json whitespace=cr-at-eol
/data/raw/hust_program_curriculum_sources.json whitespace=cr-at-eol
