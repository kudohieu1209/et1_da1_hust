# HUST Course Advisor & Degree Audit Engine
# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# Cấu hình Model Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=

# Cấu hình Server
API_HOST=0.0.0.0
API_PORT=8000

# Origin của frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB lưu hội thoại và hồ sơ sinh viên (Atlas M0: Connect > Drivers > Python).
# Để trống để chạy offline bằng SQLite + file JSON cục bộ.
# Atlas: chỉ thêm IP của bạn vào Network Access, không mở 0.0.0.0/0.
MONGODB_URI=
MONGODB_DB=hust_course_advisor
