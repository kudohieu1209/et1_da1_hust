# HUST Course Advisor & Degree Audit Engine
# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=

# Cấu hình Model Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
# Thời gian chờ tối đa (giây) cho mỗi lần gọi Gemini
GEMINI_TIMEOUT_SECONDS=45

# Cấu hình Server
API_HOST=0.0.0.0
API_PORT=8000

# Origin của frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB bắt buộc cho tài khoản, phiên, hồ sơ, hội thoại và ghi nhớ học tập.
# Dùng Atlas (Connect > Drivers > Python) hoặc MongoDB local; thiếu URI sẽ dừng khởi động.
# Atlas: chỉ thêm IP của bạn vào Network Access, không mở 0.0.0.0/0.
MONGODB_URI=
MONGODB_DB=hust_course_advisor
